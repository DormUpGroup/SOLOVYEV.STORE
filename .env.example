NEXT_PUBLIC_SITE_URL=https://solovyev.store
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Supabase
# Also configure Authentication → URL Configuration:
# Site URL = NEXT_PUBLIC_SITE_URL, Redirect URL = <site>/auth/callback
# Authentication → Providers → Email: enable email/password.
# Enable "Confirm email" so registration requires ownership proof.
# Configure the "Confirm signup" and "Reset password" email templates.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Database password from Dashboard → Project Settings → Database
SUPABASE_DB_PASSWORD=
# Optional full URI instead of SUPABASE_DB_PASSWORD
# SUPABASE_DB_URL=postgresql://postgres:...@db.<ref>.supabase.co:5432/postgres

# Admin panel (secret URL: /{ADMIN_PATH}) — required in all environments
# Rotate ADMIN_PATH if the previous default was ever deployed.
ADMIN_LOGIN=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_PATH=

# Optional — legacy Cloudinary image cleanup
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Phase 2 — Instagram auto-sync
# CRON_SECRET is required; requests without Bearer CRON_SECRET are rejected.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
CRON_SECRET=
