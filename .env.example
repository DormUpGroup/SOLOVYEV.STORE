NEXT_PUBLIC_SITE_URL=https://solovyev.store
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Supabase
# Also configure Authentication → URL Configuration:
# Site URL = NEXT_PUBLIC_SITE_URL, Redirect URL = <site>/auth/callback
# Authentication → Providers → Email: enable email/password and disable Confirm email.
# Configure the "Reset password" email template to use {{ .ConfirmationURL }}.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Database password from Dashboard → Project Settings → Database
SUPABASE_DB_PASSWORD=
# Optional full URI instead of SUPABASE_DB_PASSWORD
# SUPABASE_DB_URL=postgresql://postgres:...@db.<ref>.supabase.co:5432/postgres

# Admin panel (secret URL: /{ADMIN_PATH})
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_PATH=s9Vm2kQx

# Optional — legacy Cloudinary image cleanup
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Phase 2 — Instagram auto-sync
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
CRON_SECRET=
