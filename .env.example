NEXT_PUBLIC_SITE_URL=https://solovyev.store
# Required for GA4 on Vercel (Production + Preview). Redeploy after setting.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Admin Overview/Analytics via Google Analytics Data API (server-only).
# Property ID: GA Admin → Property settings → Property ID (digits, not G-...).
# Create a GCP service account, enable Analytics Data API, download JSON key,
# then add the service account email as Viewer on the GA4 property.
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
# Paste private_key from the JSON. On Vercel: paste WITHOUT surrounding quotes;
# keep \n as the two characters backslash+n (single line).
GA4_PRIVATE_KEY=
# Optional alternative to CLIENT_EMAIL + PRIVATE_KEY: paste the whole service
# account JSON as one line (easier on Vercel).
# GA4_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Supabase
# Also configure Authentication → URL Configuration:
# Site URL = NEXT_PUBLIC_SITE_URL, Redirect URL = <site>/auth/callback
# Authentication → Providers → Email: enable email/password.
# Registration confirms accounts server-side (no email verification step).
# Configure the "Reset password" email template to use {{ .ConfirmationURL }}.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Database password from Dashboard → Project Settings → Database
SUPABASE_DB_PASSWORD=
# Optional full URI instead of SUPABASE_DB_PASSWORD
# SUPABASE_DB_URL=postgresql://postgres:...@db.<ref>.supabase.co:5432/postgres

# Admin panel (secret URL: /{ADMIN_PATH}) — required in all environments
# Rotate ADMIN_PATH if the previous default was ever deployed.
ADMIN_LOGIN=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_PATH=

# Optional — legacy Cloudinary image cleanup
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Phase 2 — Instagram auto-sync
# CRON_SECRET is required; requests without Bearer CRON_SECRET are rejected.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
CRON_SECRET=

# Grow card checkout. Leave empty until the account is live; checkout then returns 503.
# Prefer Make (included in the Grow plan). Direct API keys are the separate ₪500/month add-on.
# Make scenario: custom webhook -> Grow "Create Payment Link" (sending mode none, VAT exempt)
# -> Webhook response JSON { "paymentUrl", "processId", "processToken" }.
# Same scenario, filter action = approve -> Grow "Approve Transaction".
# Map Custom Field 1 to orderId. Success URL and Notify URL come from the webhook body.
# Store is עוסק פטור (no VAT). Put the Make vars on Vercel Production + Preview, then Redeploy.
MAKE_GROW_WEBHOOK_URL=
MAKE_GROW_SECRET=
# Direct Light API, only if the API add-on is enabled:
# Sandbox: https://sandbox.meshulam.co.il/api/light/server/1.0
# Production: https://secure.meshulam.co.il/api/light/server/1.0
GROW_USER_ID=
GROW_PAGE_CODE=
GROW_API_BASE=https://sandbox.meshulam.co.il/api/light/server/1.0
