{
  "name": "solovyev-store",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "dev:fresh": "node scripts/dev-fresh.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true}); require('fs').rmSync('out',{recursive:true,force:true});\"",
    "import:instagram": "node scripts/import-instagram-products.mjs from-raw data/instagram-raw.json && node scripts/import-instagram-products.mjs merge",
    "import:brand-logos": "node scripts/download-brand-logos.mjs"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "simple-icons": "^14.15.0",
    "typescript": "^5.0.0"
  }
}
