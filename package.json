{
  "name": "solovyev-store",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "node scripts/copy-catalog-to-public.mjs",
    "dev": "next dev --port 3000",
    "prebuild": "node scripts/copy-catalog-to-public.mjs && node scripts/guard-build-env.mjs",
    "dev:fresh": "node scripts/dev-fresh.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "clean": "node scripts/clean.mjs",
    "import:instagram": "node scripts/import-instagram-products.mjs from-raw data/instagram-raw.json && node scripts/import-instagram-products.mjs merge",
    "import:brand-logos": "node scripts/download-brand-logos.mjs",
    "import:catalog": "node scripts/import-catalog.mjs",
    "seed:supabase": "node scripts/seed-supabase.mjs",
    "setup:supabase": "node scripts/setup-supabase.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google-analytics/data": "^7.0.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "chart.js": "^4.5.1",
    "lucide-react": "^1.33.0",
    "next": "^15.5.0",
    "pdfkit": "^0.19.1",
    "react": "^19.1.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.5.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "pg": "^8.22.0",
    "postcss": "^8.5.16",
    "simple-icons": "^14.15.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.0.0"
  }
}
